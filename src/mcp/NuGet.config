<?xml version="1.0" encoding="utf-8"?>
<!--
  Atlantis MCP (Spec 0070; ADR-0138 D2): the host's package sources, the
  same policy as the editor app's (ADR-0127 D3). Inherited sources are
  cleared and exactly one is added: nuget.org. An offline build passes
  ATLANTIS_NUGET_OFFLINE_FEED (a directory holding the locked .nupkg files)
  to CMake, which restores from it instead (RestoreSources). Checked by
  cmake/check_editor_app_packages.cmake. The repository root's NuGet.config
  (the C# SDK's: no sources) is not changed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
