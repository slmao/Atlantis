# Spec 0064 / ADR-0127 D7 (Plan 0064 M5): fills an offline NuGet feed with
# exactly the packages Atlantis Editor App's lock files name, copied from a
# NuGet global packages folder. A locked-mode restore from the feed checks
# each package against its lock file's content hash (NuGet's, which excludes
# a signed package's signature).
#   cmake -DFEED=<dir> [-DPACKAGES=<global packages folder>] -P src/editor_app/populate_offline_feed.cmake
# PACKAGES defaults to NUGET_PACKAGES, else %USERPROFILE%/.nuget/packages. An
# offline build then configures with -DATLANTIS_NUGET_OFFLINE_FEED=<dir>.
if(NOT FEED)
  message(FATAL_ERROR "pass -DFEED=<directory>")
endif()
if(NOT PACKAGES)
  if(DEFINED ENV{NUGET_PACKAGES})
    set(PACKAGES "$ENV{NUGET_PACKAGES}")
  else()
    set(PACKAGES "$ENV{USERPROFILE}/.nuget/packages")
  endif()
endif()
file(TO_CMAKE_PATH "${PACKAGES}" PACKAGES)
file(MAKE_DIRECTORY "${FEED}")

file(GLOB_RECURSE _locks "${CMAKE_CURRENT_LIST_DIR}/*packages.lock.json")
list(FILTER _locks EXCLUDE REGEX "/(bin|obj)/")
set(_copied "")
set(_failures "")
foreach(_lock IN LISTS _locks)
  file(READ "${_lock}" _json)
  string(JSON _frameworks LENGTH "${_json}" dependencies)
  math(EXPR _last "${_frameworks} - 1")
  foreach(_f RANGE ${_last})
    string(JSON _framework MEMBER "${_json}" dependencies ${_f})
    string(JSON _count LENGTH "${_json}" dependencies "${_framework}")
    if(_count EQUAL 0)
      continue()
    endif()
    math(EXPR _lastPackage "${_count} - 1")
    foreach(_p RANGE ${_lastPackage})
      string(JSON _package MEMBER "${_json}" dependencies "${_framework}" ${_p})
      string(JSON _type GET "${_json}" dependencies "${_framework}" "${_package}" type)
      if(_type STREQUAL "Project")
        continue()
      endif()
      string(JSON _version GET "${_json}" dependencies "${_framework}" "${_package}" resolved)
      string(TOLOWER "${_package}" _id)
      if("${_id}/${_version}" IN_LIST _copied)
        continue()
      endif()
      set(_nupkg "${PACKAGES}/${_id}/${_version}/${_id}.${_version}.nupkg")
      if(NOT EXISTS "${_nupkg}")
        string(APPEND _failures "  ${_id} ${_version}: not in ${PACKAGES} (restore once online first)\n")
        continue()
      endif()
      file(COPY "${_nupkg}" DESTINATION "${FEED}")
      list(APPEND _copied "${_id}/${_version}")
    endforeach()
  endforeach()
endforeach()
if(_failures)
  message(FATAL_ERROR "the offline feed is incomplete:\n${_failures}")
endif()
list(LENGTH _copied _n)
message(STATUS "offline feed ${FEED}: ${_n} package(s) from ${PACKAGES}")
