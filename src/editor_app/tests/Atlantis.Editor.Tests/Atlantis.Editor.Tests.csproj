<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Atlantis Editor App's tests (Plan 0064 M5): a console program, like the
    C# SDK's (no test framework package). It references the editor project;
    its packages are the editor's, locked in this project's own
    packages.lock.json (ADR-0127 D2).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Atlantis.Editor.Tests</RootNamespace>
    <AssemblyName>Atlantis.Editor.Tests</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Atlantis.Editor/Atlantis.Editor.csproj" />
    <ProjectReference Include="../../Atlantis.Editor.Model/Atlantis.Editor.Model.csproj" />
  </ItemGroup>

</Project>
