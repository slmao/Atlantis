<Project>
  <!--
    Atlantis Editor App (Spec 0064; ADR-0127 D2): every package version,
    exact and in one place (central package management), for the projects
    under src/editor_app/ only; the C# SDK keeps zero NuGet.

    Locked restore: each project commits its packages.lock.json and restores
    in locked mode, so a version or content-hash drift fails the restore.
    After changing a version here, regenerate the lock files once with
      dotnet restore src/editor_app/Atlantis.Editor/Atlantis.Editor.csproj -p:RestoreLockedMode=false
      dotnet restore src/editor_app/tests/Atlantis.Editor.Tests/Atlantis.Editor.Tests.csproj -p:RestoreLockedMode=false
    and review the lock-file diff with the change. Checked by
    cmake/check_editor_app_packages.cmake.

    Avalonia 12.1.4: the newest stable release on nuget.org at Plan 0064 M5
    (2026-10-20); MIT licence.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="[12.1.4]" />
    <PackageVersion Include="Avalonia.Desktop" Version="[12.1.4]" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="[12.1.4]" />
  </ItemGroup>
</Project>
