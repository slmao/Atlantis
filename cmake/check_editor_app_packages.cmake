# Spec 0064 / ADR-0127 D5 (Plan 0064 P4): Atlantis Editor App's managed
# dependency policy, checked without .NET:
#   cmake -DATLANTIS_SOURCE_DIR=<repo> [-DEDITOR_APP_DIR=<dir>] -P check_editor_app_packages.cmake
# EDITOR_APP_DIR defaults to <repo>/src/editor_app (the negative tests point it
# at a mutated copy). It fails when:
# - a PackageReference carries its own Version/VersionOverride, or names a
#   package with no PackageVersion in Directory.Packages.props;
# - a PackageVersion is not an exact pin ("[x.y.z]");
# - a referenced or versioned package is not on allowed_packages.txt;
# - a project has no committed packages.lock.json, or a lock file's direct
#   dependency disagrees with Directory.Packages.props;
# - Directory.Packages.props does not turn on central management, lock files
#   and locked-mode restore;
# - NuGet.config does not clear its sources and add exactly nuget.org.
# The C# SDK's zero-NuGet rules (tests/csharp/check_csharp_rules.cmake) are
# separate and unchanged.
if(NOT ATLANTIS_SOURCE_DIR)
  message(FATAL_ERROR "pass -DATLANTIS_SOURCE_DIR=<repository root>")
endif()
# Spec 0070 (Plan 0070 J5): one script over every managed area. AREA_DIR names
# the area; EDITOR_APP_DIR is the original spelling (the editor app's negative
# tests still use it) and wins only when AREA_DIR is absent.
if(AREA_DIR)
  set(_area_dir "${AREA_DIR}")
elseif(EDITOR_APP_DIR)
  set(_area_dir "${EDITOR_APP_DIR}")
else()
  set(_area_dir "${ATLANTIS_SOURCE_DIR}/src/editor_app")
endif()
set(EDITOR_APP_DIR "${_area_dir}")

set(_failures "")

# The allow-list: one package id per line, '#' comments.
set(_allowed "")
if(EXISTS "${EDITOR_APP_DIR}/allowed_packages.txt")
  file(STRINGS "${EDITOR_APP_DIR}/allowed_packages.txt" _lines)
  foreach(_line IN LISTS _lines)
    string(REGEX REPLACE "#.*$" "" _line "${_line}")
    string(STRIP "${_line}" _line)
    if(NOT _line STREQUAL "")
      string(TOLOWER "${_line}" _id)
      list(APPEND _allowed "${_id}")
    endif()
  endforeach()
else()
  string(APPEND _failures "  allowed_packages.txt is missing\n")
endif()

# Directory.Packages.props: central management on, lock files, locked mode,
# and exact pins.
set(_versions_ids "")
set(_props "${EDITOR_APP_DIR}/Directory.Packages.props")
if(EXISTS "${_props}")
  file(READ "${_props}" _text)
  foreach(_setting IN ITEMS
      "<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>"
      "<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>")
    string(FIND "${_text}" "${_setting}" _at)
    if(_at EQUAL -1)
      string(APPEND _failures "  Directory.Packages.props: missing ${_setting}\n")
    endif()
  endforeach()
  if(NOT _text MATCHES "<RestoreLockedMode[^>]*>true</RestoreLockedMode>")
    string(APPEND _failures "  Directory.Packages.props: RestoreLockedMode is not on\n")
  endif()
  if(_text MATCHES "<GlobalPackageReference")
    string(APPEND _failures "  Directory.Packages.props: a GlobalPackageReference\n")
  endif()
  string(REGEX MATCHALL "<PackageVersion[^>]*>" _entries "${_text}")
  foreach(_entry IN LISTS _entries)
    if(NOT _entry MATCHES "Include=\"([^\"]+)\"")
      string(APPEND _failures "  Directory.Packages.props: a PackageVersion without Include\n")
      continue()
    endif()
    string(TOLOWER "${CMAKE_MATCH_1}" _id)
    if(NOT _entry MATCHES "Version=\"\\[([0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?)\\]\"")
      string(APPEND _failures "  Directory.Packages.props: ${_id} is not pinned exactly (Version=\"[x.y.z]\")\n")
      continue()
    endif()
    set(_version_${_id} "${CMAKE_MATCH_1}")
    list(APPEND _versions_ids "${_id}")
    list(FIND _allowed "${_id}" _ok)
    if(_ok EQUAL -1)
      string(APPEND _failures "  Directory.Packages.props: ${_id} is not on allowed_packages.txt\n")
    endif()
  endforeach()
else()
  string(APPEND _failures "  Directory.Packages.props is missing\n")
endif()

# Every project: references through the central versions, on the list, with
# a committed lock file that agrees.
file(GLOB_RECURSE _projects "${EDITOR_APP_DIR}/*.csproj")
list(FILTER _projects EXCLUDE REGEX "/(bin|obj)/")
list(LENGTH _projects _project_count)
if(_project_count EQUAL 0)
  string(APPEND _failures "  no project under ${EDITOR_APP_DIR}\n")
endif()
file(GLOB_RECURSE _other_props "${EDITOR_APP_DIR}/*.props" "${EDITOR_APP_DIR}/*.targets")
list(FILTER _other_props EXCLUDE REGEX "/(bin|obj)/")
foreach(_file IN LISTS _projects _other_props)
  file(READ "${_file}" _text)
  get_filename_component(_name "${_file}" NAME)
  string(REGEX MATCHALL "<PackageReference[^>]*>" _references "${_text}")
  foreach(_reference IN LISTS _references)
    if(NOT _reference MATCHES "Include=\"([^\"]+)\"")
      string(APPEND _failures "  ${_name}: a PackageReference without Include\n")
      continue()
    endif()
    string(TOLOWER "${CMAKE_MATCH_1}" _id)
    if(_reference MATCHES "(Version|VersionOverride)=")
      string(APPEND _failures "  ${_name}: ${_id} carries its own version (versions live in Directory.Packages.props)\n")
    endif()
    list(FIND _allowed "${_id}" _ok)
    if(_ok EQUAL -1)
      string(APPEND _failures "  ${_name}: ${_id} is not on allowed_packages.txt\n")
    endif()
    list(FIND _versions_ids "${_id}" _pinned)
    if(_pinned EQUAL -1)
      string(APPEND _failures "  ${_name}: ${_id} has no exact PackageVersion\n")
    endif()
  endforeach()
  if(_text MATCHES "<(PackageDownload|GlobalPackageReference)[ \t\r\n/>]")
    string(APPEND _failures "  ${_name}: a PackageDownload or GlobalPackageReference\n")
  endif()
endforeach()

foreach(_project IN LISTS _projects)
  get_filename_component(_dir "${_project}" DIRECTORY)
  get_filename_component(_name "${_project}" NAME)
  set(_lock "${_dir}/packages.lock.json")
  if(NOT EXISTS "${_lock}")
    string(APPEND _failures "  ${_name}: no committed packages.lock.json\n")
    continue()
  endif()
  file(READ "${_lock}" _json)
  string(JSON _frameworks ERROR_VARIABLE _error LENGTH "${_json}" dependencies)
  if(_error)
    string(APPEND _failures "  ${_name}: packages.lock.json is not a lock file (${_error})\n")
    continue()
  endif()
  math(EXPR _last "${_frameworks} - 1")
  foreach(_f RANGE ${_last})
    string(JSON _framework MEMBER "${_json}" dependencies ${_f})
    string(JSON _count LENGTH "${_json}" dependencies "${_framework}")
    if(_count EQUAL 0)
      continue()
    endif()
    math(EXPR _lastPackage "${_count} - 1")
    foreach(_p RANGE ${_lastPackage})
      string(JSON _package MEMBER "${_json}" dependencies "${_framework}" ${_p})
      string(JSON _type GET "${_json}" dependencies "${_framework}" "${_package}" type)
      if(NOT _type STREQUAL "Direct")
        continue()
      endif()
      string(TOLOWER "${_package}" _id)
      string(JSON _requested GET "${_json}" dependencies "${_framework}" "${_package}" requested)
      string(JSON _resolved GET "${_json}" dependencies "${_framework}" "${_package}" resolved)
      if(NOT DEFINED _version_${_id})
        string(APPEND _failures "  ${_name}: the lock file's direct ${_id} has no PackageVersion\n")
      else()
        # NuGet writes an exact pin [v] as "[v, v]".
        set(_pin "${_version_${_id}}")
        if(NOT (_requested STREQUAL "[${_pin}]" OR _requested STREQUAL "[${_pin}, ${_pin}]") OR
           NOT _resolved STREQUAL "${_pin}")
          string(APPEND _failures
            "  ${_name}: the lock file has ${_id} ${_requested} -> ${_resolved}, Directory.Packages.props pins [${_pin}]\n")
        endif()
      endif()
    endforeach()
  endforeach()
endforeach()

# NuGet.config: cleared, then exactly nuget.org.
set(_config "${EDITOR_APP_DIR}/NuGet.config")
if(EXISTS "${_config}")
  file(READ "${_config}" _text)
  string(REGEX REPLACE "<!--.*-->" "" _text "${_text}")
  if(NOT _text MATCHES "<packageSources>[ \t\r\n]*<clear[ \t]*/>")
    string(APPEND _failures "  NuGet.config: packageSources must start with <clear />\n")
  endif()
  string(REGEX MATCHALL "<add [^>]*>" _adds "${_text}")
  list(LENGTH _adds _add_count)
  if(NOT _add_count EQUAL 1 OR NOT _adds MATCHES "value=\"https://api\\.nuget\\.org/v3/index\\.json\"")
    string(APPEND _failures "  NuGet.config: must add exactly one source, https://api.nuget.org/v3/index.json\n")
  endif()
else()
  string(APPEND _failures "  NuGet.config is missing\n")
endif()

if(_failures)
  message(FATAL_ERROR "Atlantis Editor App package policy (ADR-0127) violated:\n${_failures}")
endif()
list(LENGTH _versions_ids _package_count)
message(STATUS "Atlantis Editor App package policy (ADR-0127): ${_project_count} project(s), ${_package_count} pinned package(s), "
               "lock files committed, nuget.org only")
