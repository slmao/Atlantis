# Spec 0088: select one ordinary scene unit in the development assets tree.
function(atlantis_select_saved_scene)
  string(LENGTH "${ATLANTIS_SAVED_SCENE}" name_length)
  if(name_length GREATER 48 OR NOT ATLANTIS_SAVED_SCENE MATCHES "^[a-z][a-z0-9_]*$")
    message(FATAL_ERROR "Invalid ATLANTIS_SAVED_SCENE logical name")
  endif()
  set(pending_selection "${CMAKE_CURRENT_BINARY_DIR}/managed-pending.txt")
  if(EXISTS "${pending_selection}")
    file(READ "${pending_selection}" pending)
    if(NOT pending STREQUAL "")
      message(FATAL_ERROR "Saved-slot builds accept only committed managed imports")
    endif()
  endif()
  set(relative "scenes/saved/save_${ATLANTIS_SAVED_SCENE}")
  set(unit "${CMAKE_CURRENT_SOURCE_DIR}/${relative}")
  set(fragment "${unit}/catalog-source.txt")
  set(scene "${unit}/scene.scene.txt")
  file(GLOB units LIST_DIRECTORIES true "${CMAKE_CURRENT_SOURCE_DIR}/scenes/saved/*")
  file(GLOB leaves LIST_DIRECTORIES true "${unit}/*")
  if(NOT unit IN_LIST units OR NOT fragment IN_LIST leaves OR NOT scene IN_LIST leaves)
    message(FATAL_ERROR "Missing or noncanonical selected scene unit: ${unit}")
  endif()
  foreach(path IN ITEMS "${unit}" "${fragment}" "${scene}")
    file(REAL_PATH "${path}" resolved)
    string(TOLOWER "${resolved}" resolved_folded)
    string(TOLOWER "${path}" path_folded)
    if(NOT EXISTS "${path}" OR IS_SYMLINK "${path}" OR NOT resolved_folded STREQUAL path_folded)
      message(FATAL_ERROR "Missing or unsafe selected scene unit: ${path}")
    endif()
  endforeach()
  if(NOT IS_DIRECTORY "${unit}" OR IS_DIRECTORY "${fragment}" OR IS_DIRECTORY "${scene}")
    message(FATAL_ERROR "Invalid selected scene unit: ${unit}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fragment}" "${ATLANTIS_ASSET_CATALOG_SOURCE}")
  file(STRINGS "${fragment}" lines)
  list(LENGTH lines count)
  if(NOT count EQUAL 3)
    message(FATAL_ERROR "A saved scene unit needs one catalog-source entry")
  endif()
  list(GET lines 0 version)
  list(GET lines 1 count_line)
  list(GET lines 2 entry)
  if(NOT version STREQUAL "atlantis_asset_catalog_source_version: 1" OR NOT count_line STREQUAL "entry_count: 1" OR
     NOT entry MATCHES "^asset: guid=([0-9a-f-]+) type=scene root=assets path=${relative}/scene[.]scene[.]txt$")
    message(FATAL_ERROR "Invalid saved scene catalog fragment: ${fragment}")
  endif()
  set(guid "${CMAKE_MATCH_1}")
  string(REPLACE "-" ";" guid_parts "${guid}")
  list(LENGTH guid_parts guid_count)
  if(NOT guid_count EQUAL 5 OR guid STREQUAL "00000000-0000-0000-0000-000000000000")
    message(FATAL_ERROR "Invalid saved scene GUID: ${guid}")
  endif()
  set(widths 8 4 4 4 12)
  foreach(i RANGE 0 4)
    list(GET guid_parts ${i} part)
    list(GET widths ${i} width)
    string(LENGTH "${part}" length)
    if(NOT length EQUAL width)
      message(FATAL_ERROR "Invalid saved scene GUID: ${guid}")
    endif()
  endforeach()
  file(STRINGS "${ATLANTIS_ASSET_CATALOG_SOURCE}" entries REGEX "^asset: ")
  list(APPEND entries "${entry}")
  set(ordered "")
  foreach(row IN LISTS entries)
    if(NOT row MATCHES " root=([a-z]+) path=(.+)$")
      message(FATAL_ERROR "Malformed catalog source entry")
    endif()
    list(APPEND ordered "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}|${row}")
  endforeach()
  list(SORT ordered)
  list(LENGTH ordered count)
  set(content "atlantis_asset_catalog_source_version: 1\nentry_count: ${count}\n")
  foreach(row IN LISTS ordered)
    string(REGEX REPLACE "^[^|]*[|]" "" value "${row}")
    string(APPEND content "${value}\n")
  endforeach()
  set(output "${CMAKE_CURRENT_BINARY_DIR}/saved-catalog-source.txt")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
  set_property(GLOBAL PROPERTY ATLANTIS_EFFECTIVE_CATALOG_SOURCE "${output}")
  set(ATLANTIS_ASSET_CATALOG_SOURCE "${output}" PARENT_SCOPE)
  set(saved_scene_source "${relative}/scene.scene.txt" PARENT_SCOPE)
endfunction()

function(atlantis_check_saved_scene_catalog)
  file(STRINGS "${ATLANTIS_ASSET_CATALOG_SOURCE}" entries REGEX "^asset: ")
  set(guids "")
  set(paths "")
  foreach(row IN LISTS entries)
    if(NOT row MATCHES "^asset: guid=([^ ]+) type=[^ ]+ root=([^ ]+) path=(.+)$")
      message(FATAL_ERROR "Malformed effective catalog source entry")
    endif()
    string(TOLOWER "${CMAKE_MATCH_1}" guid)
    string(TOLOWER "${CMAKE_MATCH_2}:${CMAKE_MATCH_3}" path)
    if(guid IN_LIST guids OR path IN_LIST paths)
      message(FATAL_ERROR "Duplicate GUID or path in saved-slot catalog: ${row}")
    endif()
    list(APPEND guids "${guid}")
    list(APPEND paths "${path}")
  endforeach()
endfunction()

function(atlantis_check_saved_scene_generated_identities)
  set(probe "${CMAKE_SOURCE_DIR}/src/tools/gltf_importer")
  set(build "${CMAKE_CURRENT_BINARY_DIR}/saved-scene-identity")
  set(configure -S "${probe}/configure_check" -B "${build}" -G "${CMAKE_GENERATOR}"
    "-DCMAKE_BUILD_TYPE=Release" "-DATLANTIS_CGLTF_SOURCE=${cgltf_SOURCE_DIR}")
  if(CMAKE_GENERATOR_PLATFORM)
    list(APPEND configure -A "${CMAKE_GENERATOR_PLATFORM}")
  endif()
  if(CMAKE_GENERATOR_TOOLSET)
    list(APPEND configure -T "${CMAKE_GENERATOR_TOOLSET}")
  endif()
  if(CMAKE_GENERATOR_INSTANCE)
    list(APPEND configure "-DCMAKE_GENERATOR_INSTANCE=${CMAKE_GENERATOR_INSTANCE}")
  endif()
  if(NOT CMAKE_GENERATOR MATCHES "^Visual Studio")
    list(APPEND configure "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}" "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" ${configure} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot configure the saved scene identity check\n${output}\n${errors}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config Release --target saved_scene_identity --parallel 4
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot build the saved scene identity check\n${output}\n${errors}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${probe}/configure_check/main.cpp" "${probe}/configure_check/CMakeLists.txt"
    "${probe}/import_command.cpp" "${probe}/material_import.cpp"
    "${CMAKE_SOURCE_DIR}/src/asset_system/src/asset_guid.cpp")

  get_property(imports GLOBAL PROPERTY ATLANTIS_SAVED_SCENE_IMPORTS)
  list(JOIN imports "\n" inputs)
  if(inputs)
    string(APPEND inputs "\n")
  endif()
  set(input_file "${build}/imports.txt")
  file(WRITE "${input_file}" "${inputs}")
  execute_process(COMMAND "${build}/bin/saved_scene_identity.exe"
    "${ATLANTIS_ASSET_CATALOG_SOURCE}" "${saved_scene_source}" "${input_file}"
    RESULT_VARIABLE result ERROR_VARIABLE errors)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Saved scene identity validation failed\n${errors}")
  endif()
endfunction()

# Spec 0086: build-time view of a trusted local project registration.
function(atlantis_add_managed_imports)
  file(REAL_PATH "${ATLANTIS_MANAGED_IMPORT_ROOT}" managed_root)
  if(NOT IS_DIRECTORY "${managed_root}/registered")
    message(FATAL_ERROR "Managed import project requires a registered directory")
  endif()

  set(managed_pending_file "${CMAKE_CURRENT_BINARY_DIR}/managed-pending.txt")
  if(NOT EXISTS "${managed_pending_file}")
    file(WRITE "${managed_pending_file}" "")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${managed_pending_file}")
  file(READ "${managed_pending_file}" managed_pending)
  file(GLOB managed_units LIST_DIRECTORIES true CONFIGURE_DEPENDS "${managed_root}/registered/managed_*")
  file(GLOB material_units LIST_DIRECTORIES true CONFIGURE_DEPENDS "${managed_root}/registered/material_*")
  if(NOT managed_pending STREQUAL "")
    if(managed_pending MATCHES "^[.]pending/[0-9a-f-]+/material_[a-z][a-z0-9_]*$")
      get_filename_component(material_name "${managed_pending}" NAME)
      list(REMOVE_ITEM material_units "${managed_root}/registered/${material_name}")
      list(APPEND material_units "${managed_root}/${managed_pending}")
    elseif(managed_pending MATCHES "^[.]pending/[0-9a-f-]+/managed_[a-z][a-z0-9_]*$")
      list(APPEND managed_units "${managed_root}/${managed_pending}")
    else()
      message(FATAL_ERROR "Invalid managed import pending selection")
    endif()
  endif()
  file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/managed-project.txt"
    CONTENT "${managed_root}" @ONLY)

  file(STRINGS "${ATLANTIS_ASSET_CATALOG_SOURCE}" managed_entries REGEX "^asset: ")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ATLANTIS_ASSET_CATALOG_SOURCE}")
  set(managed_names "")
  foreach(unit IN LISTS managed_units)
    get_filename_component(name "${unit}" NAME)
    if(NOT name MATCHES "^managed_[a-z][a-z0-9_]*$" OR name IN_LIST managed_names OR
       IS_SYMLINK "${unit}" OR IS_SYMLINK "${unit}/source.gltf" OR IS_SYMLINK "${unit}/catalog-source.txt" OR
       NOT EXISTS "${unit}/source.gltf" OR NOT EXISTS "${unit}/catalog-source.txt")
      message(FATAL_ERROR "Invalid or duplicate managed import: ${name}")
    endif()
    list(APPEND managed_names "${name}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${unit}/catalog-source.txt")
    file(STRINGS "${unit}/catalog-source.txt" fragment)
    list(LENGTH fragment fragment_length)
    if(NOT fragment_length EQUAL 3)
      message(FATAL_ERROR "Invalid managed catalog source for ${name}")
    endif()
    list(GET fragment 0 version)
    list(GET fragment 1 count)
    list(GET fragment 2 entry)
    if(NOT version STREQUAL "atlantis_asset_catalog_source_version: 1" OR NOT count STREQUAL "entry_count: 1" OR
       NOT entry MATCHES "^asset: guid=[0-9a-f-]+ type=gltf_import root=content path=${name}/source[.]gltf$")
      message(FATAL_ERROR "Invalid managed catalog source for ${name}")
    endif()
    list(APPEND managed_entries "${entry}")
  endforeach()

  foreach(unit IN LISTS material_units)
    get_filename_component(name "${unit}" NAME)
    set(source "${unit}/source.material.txt")
    set(fragment "${unit}/catalog-source.txt")
    if(NOT name MATCHES "^material_[a-z][a-z0-9_]*$" OR IS_SYMLINK "${unit}" OR
       IS_SYMLINK "${source}" OR IS_SYMLINK "${fragment}" OR NOT EXISTS "${source}" OR NOT EXISTS "${fragment}")
      message(FATAL_ERROR "Invalid managed material: ${name}")
    endif()
    file(SIZE "${source}" source_size)
    file(SIZE "${fragment}" fragment_size)
    if(source_size GREATER 65536 OR fragment_size GREATER 65536)
      message(FATAL_ERROR "Oversized managed material: ${name}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fragment}")
    file(STRINGS "${fragment}" fragment_lines)
    if(NOT fragment_lines MATCHES "^atlantis_asset_catalog_source_version: 1;entry_count: 1;asset: guid=[0-9a-f-]+ type=material root=content path=${name}/source[.]material[.]txt$")
      message(FATAL_ERROR "Invalid managed material registration: ${name}")
    endif()
    list(GET fragment_lines 2 entry)
    list(APPEND managed_entries "${entry}")
    configure_file("${source}" "${CMAKE_CURRENT_BINARY_DIR}/managed-material-sources/${name}/source.material.txt" COPYONLY)
  endforeach()

  set(ordered "")
  set(keys "")
  foreach(entry IN LISTS managed_entries)
    if(NOT entry MATCHES " root=([a-z]+) path=(.+)$")
      message(FATAL_ERROR "Malformed catalog source entry")
    endif()
    set(key "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
    if(key IN_LIST keys)
      message(FATAL_ERROR "Duplicate managed catalog source key: ${key}")
    endif()
    list(APPEND keys "${key}")
    list(APPEND ordered "${key}|${entry}")
  endforeach()
  list(SORT ordered)
  list(LENGTH ordered count)
  set(effective "atlantis_asset_catalog_source_version: 1\nentry_count: ${count}\n")
  foreach(row IN LISTS ordered)
    string(REGEX REPLACE "^[^|]*[|]" "" entry "${row}")
    string(APPEND effective "${entry}\n")
  endforeach()
  set(ATLANTIS_ASSET_CATALOG_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/managed-catalog-source.txt")
  file(CONFIGURE OUTPUT "${ATLANTIS_ASSET_CATALOG_SOURCE}" CONTENT "${effective}" @ONLY)
  set_property(GLOBAL PROPERTY ATLANTIS_EFFECTIVE_CATALOG_SOURCE "${ATLANTIS_ASSET_CATALOG_SOURCE}")
  if(NOT ATLANTIS_SAVED_SCENE STREQUAL "")
    set(ATLANTIS_ASSET_CATALOG_SOURCE "${ATLANTIS_ASSET_CATALOG_SOURCE}" PARENT_SCOPE)
  endif()

  foreach(unit IN LISTS managed_units)
    get_filename_component(name "${unit}" NAME)
    atlantis_add_imported_scene(MANAGED NAME "${name}" GLTF "${unit}/source.gltf" CONTENT_ROOT "${unit}")
  endforeach()
  foreach(unit IN LISTS material_units)
    get_filename_component(name "${unit}" NAME)
    atlantis_add_material_asset(NAME "${name}" SOURCE "${name}/source.material.txt" MANAGED)
  endforeach()
endfunction()
