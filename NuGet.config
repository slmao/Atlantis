<?xml version="1.0" encoding="utf-8"?>
<!--
  Atlantis C# SDK (ADR-0113 D3): zero NuGet. Every package source is cleared
  and none is added, so a restore never reaches the network and a
  PackageReference cannot resolve. Checked by tests/csharp/check_csharp_rules.cmake.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
